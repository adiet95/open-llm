# Copy to .env for local development. This file is loaded automatically on
# startup (it is git-ignored). Real OS environment variables take precedence,
# e.g. $env:LLM_API_KEY="gsk_..." overrides the value here.
#
# IMPORTANT: do NOT put inline "# comments" after a value — the value is read
# verbatim, so "LLM_MODEL=foo   # note" would include the "# note" part.

# --- Groq (free tier) — get a key at https://console.groq.com/keys ---
LLM_API_KEY=gsk_your_groq_key_here

# Optional overrides (defaults shown):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# --- Server ---
PORT=8080
LLM_REQUEST_TIMEOUT=60

# --- RAG / embeddings ---
# Groq has NO embeddings endpoint, so embeddings default to a local Ollama
# server (free, no key). First: `ollama pull nomic-embed-text`.
# To use a cloud embeddings provider instead, set EMBED_BASE_URL + EMBED_API_KEY
# to any OpenAI-compatible /embeddings endpoint.
EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=            # leave empty for local Ollama
EMBED_MODEL=nomic-embed-text

# Where the vector store JSON lives (git-ignored).
VECTOR_STORE_PATH=data/vectorstore.json

# Retrieval tuning (defaults shown):
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
